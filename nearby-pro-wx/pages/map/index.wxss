.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

.map-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
  background: #F0F4EA;
}

.map {
  width: 100%;
  height: 100%;
}

/* ---- 顶栏：定位胶囊 + 品牌章 ---- */
.masthead {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 6;
  padding: 24rpx 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.loc {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid var(--primary-line);
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(62, 110, 79, 0.08);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}

.loc-pin {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50% 50% 50% 0;
  background: var(--primary);
  transform: rotate(-45deg);
  flex-shrink: 0;
  position: relative;
}

.loc-pin::after {
  content: "";
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #fff;
  top: 7.5rpx;
  left: 7.5rpx;
}

.loc-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.loc-count {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 700;
  background: var(--primary-soft);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* ---- 筛选 ---- */
.filters {
  position: absolute;
  top: 132rpx;
  left: 0;
  right: 0;
  z-index: 5;
  padding: 0 24rpx;
}

.chips {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
}

.chips-sub {
  margin-top: 12rpx;
}

.chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 14rpx 30rpx;
  background: rgba(255, 255, 255, 0.85);
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: 1rpx solid var(--primary-line);
  box-shadow: 0 4rpx 14rpx rgba(62, 110, 79, 0.06);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
}

.chip-sm {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.chip-on {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 600;
  border-color: var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(62, 110, 79, 0.28);
}

/* ---- 定位按钮 ---- */
.fab {
  position: absolute;
  right: 28rpx;
  bottom: 32rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.fab-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 6rpx solid var(--primary);
  box-sizing: border-box;
  position: relative;
}

.fab-icon::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  border-radius: 50%;
  background: var(--primary);
}

/* ---- 底部面板 ---- */
.sheet {
  flex-shrink: 0;
  background: var(--bg);
  padding: 12rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(62, 110, 79, 0.1);
}

.handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--primary-line);
  margin: 4rpx auto 18rpx;
}

.sheet-full {
  height: 62vh;
  display: flex;
  flex-direction: column;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tool {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  border: 1.5rpx solid var(--primary-line);
  box-shadow: var(--shadow-card);
}

.tool-on {
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(62, 110, 79, 0.3);
}

.hint-num {
  font-size: 36rpx;
  font-weight: 700;
}

.hint-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.hint {
  padding: 24rpx 0 16rpx;
  text-align: center;
}

.card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--primary-line);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, var(--primary), #7FB069);
}

.card-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 700;
}

.card-kicker::before {
  content: "";
  width: 18rpx;
  height: 18rpx;
  border-radius: 50% 50% 50% 0;
  background: var(--primary);
  transform: rotate(-45deg);
  flex-shrink: 0;
}

.card-dot,
.row-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.card-dot.clean,
.row-dot.clean { background: #14B8A6; }
.card-dot.repair,
.row-dot.repair { background: #F97316; }
.card-dot.tutor,
.row-dot.tutor { background: #3B82F6; }
.card-dot.photo,
.row-dot.photo { background: #EAB308; }
.card-dot.run,
.row-dot.run { background: #22C55E; }
.card-dot.other,
.row-dot.other { background: #8B5CF6; }

.card-title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.card-go {
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: var(--primary-soft);
  color: var(--primary-deep);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.list {
  flex: 1;
  height: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
}

.row-dot {
  background: var(--ink-3);
}

.row-title {
  font-size: 30rpx;
  font-weight: 600;
}

.row-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-arrow {
  font-size: 36rpx;
  color: var(--ink-3);
  font-weight: 300;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---- 发布引导弹窗：只对没发布过的用户出现 ---- */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(26, 23, 20, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.prompt {
  width: 600rpx;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 56rpx 44rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow-float);
}

.prompt-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.prompt-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.prompt-btn {
  margin-top: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 32rpx rgba(62, 110, 79, 0.32);
}

.prompt-later {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}