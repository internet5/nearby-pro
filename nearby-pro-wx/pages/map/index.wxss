.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F4EFE6;
  overflow: hidden;
}

.chips {
  flex-shrink: 0;
  white-space: nowrap;
  width: 100%;
  box-sizing: border-box;
}

.filters {
  flex-shrink: 0;
  padding: 16rpx 24rpx 12rpx;
}

.chips-sub {
  margin-top: 12rpx;
}

.chip-sm {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 12rpx 26rpx;
  background: #EDE8DE;
  color: #44403C;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.chip-on {
  background: #C45C26;
  color: #F4EFE6;
  font-weight: 600;
}

.map-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.sheet {
  flex-shrink: 0;
  background: #F4EFE6;
  padding: 8rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #E7E5E4;
}

.sheet-full {
  height: 55vh;
  display: flex;
  flex-direction: column;
}

.toolbar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tool {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #EDE8DE;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1917;
}

.tool-on {
  background: #1C1917;
  color: #F4EFE6;
}

.hint-num {
  font-size: 34rpx;
  font-weight: 700;
}

.hint-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #78716C;
}

.card-kicker {
  font-size: 22rpx;
  color: #C45C26;
  font-weight: 600;
}

.card-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.card-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #78716C;
}

.card-go {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #C45C26;
  color: #F4EFE6;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.list {
  flex: 1;
  height: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E7E5E4;
}

.row-pin {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #57534E;
  flex-shrink: 0;
}

.row-pin.clean { background: #0F766E; }
.row-pin.repair { background: #C2410C; }
.row-pin.tutor { background: #1D4E89; }
.row-pin.photo { background: #A16207; }
.row-pin.run { background: #3F6212; }

.row-title {
  font-size: 30rpx;
  font-weight: 600;
}

.row-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #78716C;
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: #78716C;
  font-size: 26rpx;
}
