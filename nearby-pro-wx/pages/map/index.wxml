<view class="page">
  <view class="map-wrap">
    <map
      id="jobMap"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      show-location
      enable-poi="{{false}}"
      enable-markers-cluster="{{true}}"
      bindmarkertap="onMarkerTap"
      bindcallouttap="onCalloutTap"
      bindclusterclick="onClusterClick"
      bindtap="onMapTap"
    />

    <view class="masthead">
      <view class="loc">
        <view class="loc-pin"></view>
        <text class="loc-text">当前位置</text>
        <text class="loc-count">{{filtered.length}} 人在线</text>
      </view>
    </view>

    <view class="filters">
      <scroll-view class="chips" scroll-x show-scrollbar="{{false}}">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="chip {{categoryId === item.id ? 'chip-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCategory"
        >{{item.name}}</view>
      </scroll-view>
      <scroll-view wx:if="{{tagOptions.length}}" class="chips chips-sub" scroll-x show-scrollbar="{{false}}">
        <view
          class="chip chip-sm {{!activeTag ? 'chip-on' : ''}}"
          bindtap="onTagAll"
        >不限</view>
        <view
          wx:for="{{tagOptions}}"
          wx:key="*this"
          class="chip chip-sm {{activeTag === item ? 'chip-on' : ''}}"
          data-tag="{{item}}"
          bindtap="onTag"
        >{{item}}</view>
      </scroll-view>
      <scroll-view wx:if="{{itemOptions.length}}" class="chips chips-sub" scroll-x show-scrollbar="{{false}}">
        <view
          class="chip chip-sm {{!activeItem ? 'chip-on' : ''}}"
          bindtap="onItemAll"
        >全部会做</view>
        <view
          wx:for="{{itemOptions}}"
          wx:key="*this"
          class="chip chip-sm {{activeItem === item ? 'chip-on' : ''}}"
          data-item="{{item}}"
          bindtap="onItem"
        >{{item}}</view>
      </scroll-view>
    </view>

    <view class="fab" bindtap="onLocate">
      <view class="fab-icon"></view>
    </view>
  </view>

  <view class="sheet {{showList ? 'sheet-full' : ''}}">
    <view class="handle"></view>
    <view class="toolbar">
      <view class="tool" bindtap="toggleList">{{showList ? '看地图' : '看列表'}}</view>
      <view class="tool tool-on" bindtap="onPublish">发布技能</view>
    </view>

    <block wx:if="{{showList}}">
      <view class="sheet-title">{{groupFilter ? '这个位置有 ' + listItems.length + ' 项技能' : '附近 ' + filtered.length + ' 人在接活'}}</view>
      <scroll-view scroll-y class="list" wx:if="{{listItems.length}}">
        <view
          wx:for="{{listItems}}"
          wx:key="id"
          class="row"
          data-listing-id="{{item.id}}"
          bindtap="onOpenDetail"
        >
          <view class="row-dot {{item.categoryCode}}"></view>
          <view class="row-main">
            <view class="row-title">{{item.title}}</view>
            <view class="row-meta">{{item.nickname}} · {{item.itemText || item.tagText || item.categoryName}} · {{item.distanceText}}</view>
          </view>
          <view class="row-arrow">›</view>
        </view>
      </scroll-view>
      <view class="empty" wx:else>{{emptyText}}</view>
    </block>

    <block wx:else>
      <view wx:if="{{selected}}" class="card" data-listing-id="{{selected.id}}" bindtap="onOpenDetail">
        <view class="card-kicker">
          <view class="card-dot {{selected.categoryCode}}"></view>
          <text>{{selected.itemText || selected.tagText || selected.categoryName}} · {{selected.distanceText}}</text>
        </view>
        <view class="card-title">{{selected.title}}</view>
        <view class="card-sub">{{selected.nickname}} · {{selected.address}}</view>
        <view class="card-go">查看详情和联系方式 ›</view>
      </view>
      <view wx:else class="hint">
        <view class="hint-num">附近 {{filtered.length}} 人在接活</view>
        <view class="hint-sub">{{filtered.length ? '点地图上的名字看详情' : emptyText}}</view>
      </view>
    </block>
  </view>

  <view class="mask" wx:if="{{showPrompt}}" bindtap="onPromptClose">
    <view class="prompt" catchtap="noopPrompt">
      <view class="prompt-title">会手艺？让附近的人找到你</view>
      <view class="prompt-sub">发布你的技能，一键转发到微信群、朋友圈，附近有需要的人看到直接联系你。</view>
      <view class="prompt-btn" bindtap="onPromptGo">发布我的技能</view>
      <view class="prompt-later" bindtap="onPromptClose">先随便看看</view>
    </view>
  </view>
</view>
