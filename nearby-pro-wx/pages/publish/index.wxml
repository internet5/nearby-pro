<view class="page" wx:if="{{!published}}">
  <view class="sec">
    <view class="sec-head">
      <view class="sec-bar"></view>
      <view class="sec-title">选择技能</view>
    </view>

    <view class="label">技能分类<text class="req">*</text></view>
    <view class="chips">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="chip {{form.categoryId === item.id ? 'chip-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategory"
      >{{item.name}}</view>
    </view>

    <view class="label">细分标签（可多选，可不选）</view>
    <view class="chips" wx:if="{{tagItems.length}}">
      <view
        wx:for="{{tagItems}}"
        wx:key="name"
        class="chip {{item.on ? 'chip-on' : ''}}"
        data-tag="{{item.name}}"
        bindtap="onTag"
      >{{item.name}}</view>
    </view>
    <view class="hint" wx:else>先选上面的分类，再按需挑细分标签，让需求方更容易搜到你。</view>
  </view>

  <view class="sec">
    <view class="sec-head">
      <view class="sec-bar"></view>
      <view class="sec-title">介绍自己</view>
    </view>

    <view class="label">技能名称<text class="req">*</text></view>
    <view class="title-wrap">
      <!-- maxlength 用 -1：原生限制会把输入法未上屏的拼音也算进长度，拼音打够字数就打不出字。
           截断改在 onTitle 里做，计数器同步用 titleCount（已上屏字数） -->
      <input
        class="input"
        maxlength="-1"
        placeholder="最多 8 个字，例如：水电维修"
        value="{{form.title}}"
        bindinput="onTitle"
      />
      <view class="title-count {{titleCount >= 8 ? 'title-count-max' : ''}}">{{titleCount}}/8</view>
    </view>

    <view class="label">补充说明</view>
    <textarea
      class="area"
      maxlength="-1"
      placeholder="服务范围、上门时间、收费方式，写清楚需求方才找得到你"
      value="{{form.description}}"
      bindinput="onDesc"
    />

    <view class="label">技能图片（最多 3 张）</view>
    <view class="img-grid">
      <view class="img-item" wx:for="{{form.images}}" wx:key="*this">
        <image class="img-thumb" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="onPreviewImage" />
        <view class="img-del" data-index="{{index}}" catchtap="onDeleteImage">×</view>
      </view>
      <view class="img-add" wx:if="{{form.images.length < 3}}" bindtap="onAddImage">+</view>
    </view>

    <view class="label">自动回复</view>
    <textarea
      class="area area-sm"
      maxlength="-1"
      placeholder="例如：您好，看到您的咨询，工作时间内我会尽快回复～"
      value="{{form.autoReply}}"
      bindinput="onAutoReply"
    />
    <view class="hint">仅在有别人首次咨询这个技能的时候才自动回复，后续消息由你自己回复。</view>
  </view>

  <view class="sec">
    <view class="sec-head">
      <view class="sec-bar"></view>
      <view class="sec-title">服务位置<text class="req">*</text></view>
    </view>

    <view class="loc" bindtap="onChooseLocation">
      <view wx:if="{{form.address}}" class="loc-on">{{form.address}}</view>
      <view wx:else class="loc-off">在地图上选一个点</view>
      <view class="loc-arrow">›</view>
    </view>
  </view>

  <view class="submit {{submitting ? 'submit-disabled' : ''}}" bindtap="onSubmit">{{editId ? '保存修改' : '发布到地图'}}</view>
  <view class="note">发布后可一键转发到微信群、朋友圈，让附近的人直接找到你。保留 30 天，可在「我的」里提前下架。</view>
</view>

<view class="page done-page" wx:else>
  <view class="done-card">
    <view class="done-icon">✓</view>
    <view class="done-title">已发布到地图</view>
    <view class="done-sub">转发到微信群或朋友圈，附近需要「{{publishedTitle}}」的人马上就能找到你。</view>
    <button class="btn-reset done-share" open-type="share">转发技能卡片</button>
    <view class="done-map" bindtap="onGoMap">查看地图</view>
  </view>
</view>
