.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

.sec {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-card);
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.sec-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--primary), var(--primary-deep));
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
}

.label {
  margin: 28rpx 0 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 0.04em;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 14rpx 28rpx;
  background: var(--surface-soft);
  color: var(--ink);
  font-size: 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
}

.chip-on {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 600;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(228, 95, 43, 0.3);
}

.hint {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 22rpx;
  color: #8A6D3B;
  line-height: 1.6;
  background: #FBF4E4;
  border-left: 6rpx solid #E4B95B;
  border-radius: var(--radius-sm);
}

.input,
.area,
.loc {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 26rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.area {
  height: 220rpx;
  line-height: 1.6;
}

.loc {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.loc-on {
  flex: 1;
  font-weight: 600;
}

.loc-off {
  flex: 1;
  color: var(--ink-3);
}

.loc-arrow {
  font-size: 36rpx;
  color: var(--ink-3);
  font-weight: 300;
}

.seg {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0 20rpx;
  padding: 8rpx;
  background: var(--surface-soft);
  border-radius: 999rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.seg-on {
  background: var(--surface);
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(26, 23, 20, 0.1);
}

.input-gap {
  margin-top: 4rpx;
}

.submit {
  margin-top: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 32rpx rgba(228, 95, 43, 0.32);
}

.note {
  margin-top: 24rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
  text-align: center;
}
