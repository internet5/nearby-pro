<view class="page">
  <view class="hero">
    <view class="hero-title">我的发布</view>
    <view class="hero-sub">上架中的技能会出现在附近地图上，30 天后自动过期。</view>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}">
    还没有发布过。去地图页点「发布技能」，把自己标到附近。
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card"
    data-id="{{item.id}}"
    bindtap="onOpen"
  >
    <view class="card-top">
      <view class="name">{{item.title}}</view>
      <view class="status status-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="sub">{{item.categoryName}} · {{item.address}}</view>
    <view class="off" wx:if="{{item.status === 1}}" data-id="{{item.id}}" catchtap="onOffline">下架</view>
  </view>

  <view class="publish" bindtap="onPublish">发布技能</view>
</view>
