.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  box-shadow: 0 16rpx 40rpx rgba(62, 110, 79, 0.28);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

.empty {
  margin-top: 32rpx;
  padding: 72rpx 48rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.empty-icon {
  width: 104rpx;
  height: 104rpx;
  line-height: 100rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 56rpx;
  font-weight: 300;
  margin: 0 auto;
  border: 2rpx solid var(--primary-line);
  box-sizing: border-box;
}

.empty-text {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.card {
  margin-top: 24rpx;
  padding: 32rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-hover {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 20rpx rgba(26, 23, 20, 0.1);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 分类色点，与地图页列表行的配色一致 */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot.clean { background: #14B8A6; }
.dot.repair { background: #F97316; }
.dot.tutor { background: #3B82F6; }
.dot.photo { background: #EAB308; }
.dot.run { background: #22C55E; }
.dot.other { background: #8B5CF6; }

.name {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
  background: #F1EEE7;
  color: var(--ink-3);
}

.status-1 {
  background: #E7F4EC;
  color: var(--success);
}

.status-3 {
  background: #FBF0E4;
  color: #C77E2E;
}

.status-4 {
  background: #FBEAEA;
  color: #C74A3C;
}

.cat-line {
  margin-top: 14rpx;
  padding-left: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.sub {
  margin-top: 8rpx;
  padding-left: 30rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

/* 操作区：一行等宽按钮，view 和 button 混排也保持高度字号一致 */
.card-foot {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.act {
  flex: 1;
  height: 64rpx;
  line-height: 62rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 主操作（转发/重新上架）：浅绿实底 */
.act-solid {
  color: var(--primary-deep);
  background: var(--primary-soft);
  border: 1rpx solid var(--primary-line);
  font-weight: 600;
}

/* 次操作（编辑/下架/删除）：描边 */
.act-line {
  color: var(--ink-2);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.publish {
  margin-top: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 32rpx rgba(62, 110, 79, 0.32);
}

.feedback-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}
