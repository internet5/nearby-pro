.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  box-shadow: 0 16rpx 40rpx rgba(228, 95, 43, 0.28);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

.empty {
  margin-top: 32rpx;
  padding: 72rpx 48rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.empty-icon {
  width: 104rpx;
  height: 104rpx;
  line-height: 100rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 56rpx;
  font-weight: 300;
  margin: 0 auto;
  border: 2rpx solid var(--primary-line);
  box-sizing: border-box;
}

.empty-text {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.card {
  margin-top: 24rpx;
  padding: 32rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
  background: #F1EEE7;
  color: var(--ink-3);
}

.status-1 {
  background: #E7F4EC;
  color: var(--success);
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.card-foot {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.off {
  padding: 10rpx 28rpx;
  font-size: 22rpx;
  color: var(--primary-deep);
  border: 1rpx solid var(--primary-line);
  background: var(--primary-soft);
  border-radius: 999rpx;
}

.arrow {
  font-size: 36rpx;
  color: var(--ink-3);
  font-weight: 300;
}

.publish {
  margin-top: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 32rpx rgba(228, 95, 43, 0.32);
}
