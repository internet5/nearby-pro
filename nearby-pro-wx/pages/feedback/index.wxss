.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

.sec {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-card);
}

.label {
  margin: 0 0 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-2);
  letter-spacing: 0.04em;
  line-height: 1.6;
}

.area {
  width: 100%;
  height: 260rpx;
  box-sizing: border-box;
  background: var(--surface-soft);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 26rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
}

.submit {
  margin-top: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 32rpx rgba(62, 110, 79, 0.32);
}

.note {
  margin-top: 24rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
  text-align: center;
}
