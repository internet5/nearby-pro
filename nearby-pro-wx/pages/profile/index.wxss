.page {
  min-height: 100vh;
  padding: 32rpx;
  background: var(--bg);
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.field + .field {
  margin-top: 48rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.avatar-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  box-shadow: inset 0 0 0 2rpx var(--line);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-pick {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
}

.avatar-pick::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 64rpx;
  color: var(--ink-3);
  line-height: 1;
}

.avatar-tip {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.nickname-input {
  margin-top: 28rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--surface-soft);
  border-radius: var(--radius-sm);
  font-size: 30rpx;
}

.field-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.save-btn {
  margin-top: 60rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.save-disabled {
  opacity: 0.6;
}
