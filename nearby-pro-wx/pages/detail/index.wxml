<view class="page" wx:if="{{item}}">
  <view class="hero">
    <view class="hero-badge">
      <view class="hero-dot {{item.categoryCode}}"></view>
      <text>{{item.categoryName}}</text>
    </view>
    <view class="title">{{item.title}}</view>
    <view class="meta">
      <text>{{item.isOwner ? '我发布的' : item.nickname}}</text>
      <text wx:if="{{item.distanceText}}"> · 距离{{item.distanceText}}</text>
      <text wx:if="{{item.status === 1 && remainDays !== null}}"> · 剩 {{remainDays}} 天</text>
      <text wx:if="{{item.status === 2}}"> · 已下架</text>
      <text wx:if="{{item.status === 3}}"> · 已过期</text>
    </view>
  </view>

  <view class="card" wx:if="{{item.tags && item.tags.length}}">
    <view class="block-label">细分标签</view>
    <view class="tags">
      <view class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
    </view>
  </view>

  <view class="card">
    <view class="block-label">补充说明</view>
    <view class="desc">{{item.description || '发布人暂未填写说明'}}</view>
  </view>

  <view class="card" wx:if="{{item.photoUrls && item.photoUrls.length}}">
    <view class="block-label">技能图片</view>
    <view class="photo-grid">
      <image
        wx:for="{{item.photoUrls}}"
        wx:key="*this"
        class="photo-thumb"
        src="{{item}}"
        mode="aspectFill"
        data-src="{{item}}"
        bindtap="onPreviewPhoto"
      />
    </view>
  </view>

  <view class="card">
    <view class="block-label">服务位置<text class="loc-tip">点击地图查看路线</text></view>
    <view class="desc" bindtap="onOpenLocation">{{item.address || '地图标记位置'}}<text class="loc-arrow">›</text></view>
    <map
      wx:if="{{locMarkers.length}}"
      class="loc-map"
      latitude="{{item.latitude}}"
      longitude="{{item.longitude}}"
      scale="16"
      markers="{{locMarkers}}"
      polyline="{{locPolylines}}"
      include-points="{{locIncludePoints}}"
      enable-zoom="{{false}}"
      enable-scroll="{{false}}"
      enable-rotate="{{false}}"
      bindtap="onOpenLocation"
    />
  </view>

  <!-- 联系方式已不在发布页收集；老数据的值仍展示，新发布此卡片不渲染 -->
  <view class="card card-contact" wx:if="{{item.contactValue}}">
    <view class="block-label">{{item.contactType === 'phone' ? '手机号' : '微信号'}}</view>
    <view class="contact">{{item.contactValue}}</view>
  </view>

  <view class="footer">
    <view wx:if="{{!item.isOwner}}" class="link" bindtap="onChat">联系TA</view>
    <view wx:if="{{!item.isOwner}}" class="link {{item.isFavorited ? 'link-on' : ''}}" bindtap="onFavorite">{{item.isFavorited ? '已收藏 ★' : '收藏 ☆'}}</view>
    <view wx:if="{{!item.isOwner}}" class="link" bindtap="onReport">举报</view>
    <view wx:if="{{item.isOwner && item.status === 1}}" class="link" bindtap="onOffline">下架这条发布</view>
  </view>

  <view class="actions" wx:if="{{!item.isOwner || item.contactValue}}">
    <view wx:if="{{!item.isOwner}}" class="btn btn-primary" bindtap="onChat">联系TA</view>
    <view wx:if="{{item.contactValue}}" class="btn {{item.isOwner ? 'btn-primary' : 'btn-ghost'}}" bindtap="onCopy">复制联系方式</view>
    <view class="btn btn-ghost" wx:if="{{item.contactType === 'phone' && item.contactValue}}" bindtap="onCall">打电话</view>
  </view>
</view>

<view class="page empty-page" wx:else>
  <view class="empty-icon">?</view>
  <view class="empty-title">找不到这条发布</view>
  <view class="empty-sub">可能已经下架，返回地图再选一次。</view>
</view>
