.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  box-sizing: border-box;
}

.hero {
  margin-top: 24rpx;
  padding: 44rpx 36rpx;
  background: linear-gradient(135deg, #E9EFE2 0%, #F6F9F1 100%);
  border: 1rpx solid var(--primary-line);
  border-radius: var(--radius-md);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--primary-line);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--primary-deep);
  font-weight: 600;
}

.hero-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--ink-3);
}

.hero-dot.clean { background: #14B8A6; }
.hero-dot.repair { background: #F97316; }
.hero-dot.tutor { background: #3B82F6; }
.hero-dot.photo { background: #EAB308; }
.hero-dot.run { background: #22C55E; }
.hero-dot.other { background: #8B5CF6; }

.title {
  margin-top: 20rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.meta {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.card {
  margin-top: 24rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.block-label {
  font-size: 24rpx;
  color: var(--ink-3);
  font-weight: 600;
  letter-spacing: 0.04em;
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  padding: 10rpx 24rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 999rpx;
  border: 1rpx solid var(--primary-line);
}

/* 会做这些按工种分组：组名小字 + 该组的项目标签 */
.skill-group + .skill-group {
  margin-top: 24rpx;
}

.skill-group-name {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}

.desc {
  font-size: 30rpx;
  line-height: 1.7;
}

/* 位置卡片内嵌小地图：只展示发布定点，点击后打开原生位置页细看 */
.loc-map {
  margin-top: 20rpx;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  box-sizing: border-box;
}

.loc-tip {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 0;
  color: var(--ink-3);
}

.loc-arrow {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: var(--ink-3);
}

.card-contact {
  background: linear-gradient(135deg, #E9EFE2, #DDE8D6);
  border: 1rpx solid var(--primary-line);
}

.contact {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--primary-deep);
}

.footer {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.link {
  font-size: 24rpx;
  color: var(--ink-3);
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(243, 246, 238, 0.96);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid var(--line);
  box-sizing: border-box;
}

.btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #FFFFFF;
  box-shadow: 0 12rpx 28rpx rgba(62, 110, 79, 0.32);
}

.btn-ghost {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
}

.empty-page {
  text-align: center;
}

.empty-icon {
  margin-top: 160rpx;
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--ink-3);
  font-size: 56rpx;
  font-weight: 700;
  margin-left: auto;
  margin-right: auto;
}

.empty-title {
  margin-top: 32rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
