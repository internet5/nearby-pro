<view class="page">
  <template name="session-item">
    <view
      class="session"
      data-peer-id="{{item.peerId}}"
      data-nickname="{{item.nickname}}"
      data-avatar-url="{{item.avatarUrl}}"
      data-listing-id="{{item.listingId}}"
      data-title="{{item.listingTitle}}"
      bindtap="onOpenChat"
      hover-class="session-hover"
    >
      <view class="avatar">
        <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="avatar-img" />
        <text wx:else>{{item.nickname ? item.nickname[0] : '友'}}</text>
      </view>
      <view class="main">
        <view class="row1">
          <view class="skill-name">
            <block wx:if="{{item.listingTitle}}">{{item.listingTitle}}</block>
            <block wx:else>{{item.nickname || '职人'}}</block>
          </view>
          <view class="time">{{item.timeText}}</view>
        </view>
        <view class="row2" wx:if="{{item.listingTitle}}">
          <view class="name">{{item.nickname || '职人'}}</view>
          <view class="dir-tag {{item.directionClass}}">{{item.directionLabel}}</view>
        </view>
        <view class="row3">
          <view class="last">{{item.lastContent}}</view>
          <view class="badge" wx:if="{{item.unread > 0}}">{{item.unread > 99 ? '99+' : item.unread}}</view>
        </view>
      </view>
    </view>
  </template>

  <view class="empty" wx:if="{{!loading && sessions.length === 0}}">
    <view class="empty-icon">💬</view>
    <view class="empty-text">还没有聊天。在技能详情里点「联系TA」，直接和师傅沟通。</view>
  </view>

  <block wx:for="{{sessions}}" wx:key="key">
    <template is="session-item" data="{{item}}" />
  </block>
</view>
