# 生产环境配置模板：复制为 application-prod.yml 后按实际值修改
# cp application-prod.yml.example application-prod.yml
spring:
  datasource:
    # PostgreSQL 必须带 stringtype=unspecified：允许把 JSON 字符串直接写入 jsonb 列
    # （useSSL / serverTimezone 是 MySQL 的参数，PG 不需要）
    url: jdbc:postgresql://${DB_HOST:服务器IP}:5432/${DB_NAME:nearby_pro}?stringtype=unspecified
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:请改成真实密码}
    hikari:
      minimum-idle: 20
      maximum-pool-size: 100
  data:
    redis:
      host: ${REDIS_HOST:服务器IP}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      lettuce:
        pool:
          max-active: 200
          max-idle: 50

# 腾讯云 COS：与红包项目共用密钥与桶，图片传 nearby/image/ 前缀
tencent:
  cos:
    secret-id: ${TENCENT_SECRET_ID:请改成腾讯云密钥}
    secret-key: ${TENCENT_SECRET_KEY:请改成腾讯云密钥}
    bucket: ${TENCENT_COS_BUCKET:red-packet-1254310674}
    region: ${TENCENT_COS_REGION:ap-chengdu}
    base-url: ${TENCENT_COS_BASE_URL:https://red-packet-1254310674.cos.ap-chengdu.myqcloud.com}

# 微信小程序：真实接口（登录换 code、msgSecCheck 内容安全、订阅消息）
# AppSecret 在 mp.weixin.qq.com「开发管理-开发设置」获取，只配在生产，不进 git
wx:
  security-check: true
  app-id: ${WX_APPID:请改成小程序appid}
  secret: ${WX_SECRET:请改成小程序AppSecret}
